#!/bin/sh
# gws - OneCLI-mediated thin client for the GWS Policy Proxy.
# Agent containers must not receive GWS_PROXY_KEY or Google OAuth files.
# OneCLI injects proxy authorization for requests to GWS_PROXY_URL.

set -eu

case "${1:-}" in
  --version)
    echo "gws-proxy-shim 2.0.0"
    exit 0
    ;;
  --help|-h)
    cat <<'HELP'
gws - Google Workspace CLI (proxied)

Usage:
  gws auth status
  gws <service> <resource-or-shortcut> [method] [flags]

All non-local commands are forwarded to GWS_PROXY_URL/exec. OneCLI injects
proxy authorization at the network gateway.
HELP
    exit 0
    ;;
esac

if [ -z "${GWS_PROXY_URL:-}" ]; then
  echo "Error: GWS_PROXY_URL is not set; GWS access is unavailable without the mediated proxy." >&2
  exit 1
fi
GWS_PROXY_URL="${GWS_PROXY_URL%/}"

curl_with_configured_proxy() {
  proxy="${YENTE_ONECLI_GATEWAY_PROXY_URL:-${http_proxy:-${HTTP_PROXY:-${HTTPS_PROXY:-${https_proxy:-${ALL_PROXY:-${all_proxy:-}}}}}}}"
  if [ -n "$proxy" ]; then
    curl --noproxy "" --proxy "$proxy" "$@"
  else
    curl "$@"
  fi
}

json_string() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

case "${1:-}" in
  auth)
    if [ "${2:-}" = "status" ]; then
      http_code="$(curl_with_configured_proxy -fsS -o /dev/null -w "%{http_code}" "$GWS_PROXY_URL/health" 2>/dev/null || true)"
      proxy_url_json="$(json_string "$GWS_PROXY_URL")"
      if [ "$http_code" = "200" ]; then
        printf '{"auth_method":"proxy","proxy_url":"%s","status":"connected"}\n' "$proxy_url_json"
        exit 0
      fi
      printf '{"auth_method":"proxy","proxy_url":"%s","status":"unreachable"}\n' "$proxy_url_json"
      exit 1
    fi
    ;;
esac

# Read the poll-loop-written active-input file at INVOCATION time (not from env,
# which would be stale across follow-ups in this long-lived container). Absent,
# unparseable, OR stale-by-timestamp ⇒ an uncorrelated diagnostic record (no
# inputId). The path is overridable for tests via NANOCLAW_ACTIVE_INPUT_FILE.
active_input_file="${NANOCLAW_ACTIVE_INPUT_FILE:-/workspace/.active-input.json}"

# Staleness ceiling for the active-input correlation. The poll loop refreshes
# `updatedAt` on every input-accepted; a normal in-turn tool call therefore sees
# a fresh timestamp. We default to the absolute turn ceiling (6h) so a live turn
# is NEVER wrongly treated stale, while an ancient file left by a long-dead turn
# does not mis-correlate a fresh tool call. Env-overridable for tests/operators.
active_input_max_age_ms="${NANOCLAW_ACTIVE_INPUT_MAX_AGE_MS:-21600000}"

tmp_headers="$(mktemp)"
tmp_body="$(mktemp)"
tmp_arg_plan="$(mktemp)"
tmp_output_body=""
cleanup() {
  rm -f "$tmp_headers" "$tmp_body" "$tmp_arg_plan"
  if [ -n "$tmp_output_body" ]; then
    rm -f "$tmp_output_body"
  fi
}
trap cleanup EXIT

parse_status=0
readonly_output_roots="/workspace/agent:/workspace/outbox"
GWS_ARG_PLAN_FILE="$tmp_arg_plan" \
  NODE_NO_WARNINGS=1 \
  GWS_SHIM_READONLY_OUTPUT_ROOTS="$readonly_output_roots" \
  node -e '
    const fs = require("fs");
    const path = require("path");

    const args = process.argv.slice(1);
    const roots = (process.env.GWS_SHIM_READONLY_OUTPUT_ROOTS || "/workspace/agent:/workspace/outbox")
      .split(":")
      .filter(Boolean)
      .map((root) => {
        try {
          return fs.realpathSync(root);
        } catch {
          return path.resolve(root);
        }
      });

    function fail(message) {
      process.stderr.write(`Error: ${message}\n`);
      process.exit(2);
    }

    function insideRoot(candidate, root) {
      const rel = path.relative(root, candidate);
      return rel === "" || (!!rel && !rel.startsWith("..") && !path.isAbsolute(rel));
    }

	    let outputArg = null;
	    const proxyArgs = [];
	    const valueFlags = new Set([
	      "--params",
	      "--json",
	      "--format",
	      "--fields",
	      "--filter",
	      "--query",
	      "--q",
	      "--userId",
	      "--user-id",
	      "--fileId",
	      "--file-id",
	      "--documentId",
	      "--document-id",
	      "--spreadsheetId",
	      "--spreadsheet-id",
	      "--presentationId",
	      "--presentation-id",
	      "--calendarId",
	      "--calendar-id",
	      "--eventId",
	      "--event-id",
	      "--mimeType",
	      "--mime-type",
	      "--pageToken",
	      "--page-token",
	      "--pageSize",
	      "--page-size",
	    ]);
	    let parseOptions = true;
	    for (let i = 0; i < args.length; i++) {
	      const arg = args[i];
	      let value = null;
	      if (!parseOptions) {
	        proxyArgs.push(arg);
	        continue;
	      }
	      if (arg === "--") {
	        parseOptions = false;
	        proxyArgs.push(arg);
	        continue;
	      }
	      if (valueFlags.has(arg)) {
	        proxyArgs.push(arg);
	        if (i + 1 < args.length) proxyArgs.push(args[++i]);
	        continue;
	      }
	      if (arg === "-o" || arg === "--output") {
	        if (i + 1 >= args.length) fail(`${arg} requires a path value`);
	        value = args[++i];
      } else if (arg.startsWith("--output=")) {
        value = arg.slice("--output=".length);
      } else if (arg.startsWith("-o=")) {
        value = arg.slice("-o=".length);
      } else if (arg.startsWith("-o") && arg.length > 2) {
        fail("attached -oPATH output syntax is not supported; use -o PATH or --output PATH");
      }

      if (value !== null) {
        if (outputArg !== null) fail("multiple output paths were provided");
        if (value === "") fail("output path must not be empty");
        outputArg = value;
        continue;
      }

      proxyArgs.push(arg);
    }

    const plan = { proxyArgs, output: null, roots };
    if (outputArg !== null) {
      const lexicalResolved = path.resolve(process.cwd(), outputArg);
      const parent = path.dirname(lexicalResolved);
      const base = path.basename(lexicalResolved);
      if (base === "." || base === ".." || base === "") fail("output path must name a file");
      let stat;
      let parentReal;
      try {
        stat = fs.statSync(parent);
        parentReal = fs.realpathSync(parent);
      } catch {
        fail(`output parent directory does not exist: ${parent}`);
      }
      if (!stat.isDirectory()) {
        fail(`output parent path is not a directory: ${parent}`);
      }
      if (!roots.some((root) => insideRoot(parentReal, root))) {
        fail(`output path ${lexicalResolved} is outside allowed output roots: ${roots.join(":")}`);
      }
      const resolved = path.join(parentReal, base);
      try {
        const targetStat = fs.lstatSync(resolved);
        if (targetStat.isSymbolicLink()) fail(`output target is a symlink: ${resolved}`);
        fail(`output target already exists: ${resolved}`);
      } catch (e) {
        if (e && e.code !== "ENOENT") throw e;
      }
      plan.output = {
        requestedPath: outputArg,
        resolvedPath: resolved,
        parent: parentReal,
        basename: base,
      };
    }

    fs.writeFileSync(process.env.GWS_ARG_PLAN_FILE, JSON.stringify(plan));
  ' -- "$@" || parse_status=$?
if [ "$parse_status" -ne 0 ]; then
  exit "$parse_status"
fi

# Build the request body, folding in inputId/routeKey from the active-input file
# so the proxy's audit store is correlated for crash-window discovery even when a
# kill happens before the JSONL append. The shim NEVER adds an Authorization
# header (OneCLI injects it at the gateway).
request_body="$(
  NODE_NO_WARNINGS=1 NANOCLAW_ACTIVE_INPUT_FILE="$active_input_file" \
  GWS_ARG_PLAN_FILE="$tmp_arg_plan" \
  NANOCLAW_ACTIVE_INPUT_MAX_AGE_MS="$active_input_max_age_ms" node -e '
    const fs = require("fs");
    const plan = JSON.parse(fs.readFileSync(process.env.GWS_ARG_PLAN_FILE, "utf8"));
    const body = { args: plan.proxyArgs };
    if (plan.output) body.output = { mode: "return_file" };
    try {
      const ai = JSON.parse(fs.readFileSync(process.env.NANOCLAW_ACTIVE_INPUT_FILE, "utf8"));
      // Stale-by-timestamp ⇒ uncorrelated. updatedAt is refreshed each
      // input-accepted; an ancient file from a long-dead turn must not stamp a
      // fresh tool call. Missing/invalid updatedAt is treated as stale.
      const maxAge = Number(process.env.NANOCLAW_ACTIVE_INPUT_MAX_AGE_MS);
      const updatedAt = ai && typeof ai.updatedAt === "string" ? Date.parse(ai.updatedAt) : NaN;
      const stale =
        !Number.isFinite(updatedAt) || (Number.isFinite(maxAge) && maxAge > 0 && Date.now() - updatedAt > maxAge);
      if (ai && !stale) {
        if (typeof ai.inputId === "string") body.input_id = ai.inputId;
        if (typeof ai.routeKey === "string") body.route_key = ai.routeKey;
      }
    } catch (e) { /* absent/unparseable ⇒ uncorrelated */ }
    process.stdout.write(JSON.stringify(body));
  ' -- "$@"
)"

output_resolved_path="$(
  NODE_NO_WARNINGS=1 node -e '
    const fs = require("fs");
    const plan = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    process.stdout.write(plan.output ? plan.output.resolvedPath : "");
  ' "$tmp_arg_plan"
)"
output_parent="$(
  NODE_NO_WARNINGS=1 node -e '
    const fs = require("fs");
    const plan = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    process.stdout.write(plan.output ? plan.output.parent : "");
  ' "$tmp_arg_plan"
)"
curl_body_target="$tmp_body"
if [ -n "$output_resolved_path" ]; then
  tmp_output_body="$(mktemp "$output_parent/.gws-output.XXXXXX")"
  curl_body_target="$tmp_output_body"
fi

curl_status=0
http_code="$(
  curl_with_configured_proxy -sS -o "$curl_body_target" -D "$tmp_headers" -w "%{http_code}" \
    -X POST \
    -H "Content-Type: application/json" \
    -d "$request_body" \
    "$GWS_PROXY_URL/exec" 2>/dev/null
)" || curl_status=$?
if [ "$curl_status" -ne 0 ]; then
  rm -f "$tmp_output_body"
  tmp_output_body=""
  printf 'Error: GWS proxy transfer failed while receiving output bytes.\n' >&2
  exit 1
fi

if [ -z "$http_code" ] || [ "$http_code" = "000" ]; then
  rm -f "$tmp_output_body"
  tmp_output_body=""
  echo "Error: unable to reach GWS proxy at $GWS_PROXY_URL" >&2
  exit 1
fi

exit_code="$(awk 'BEGIN{IGNORECASE=1} /^X-Exit-Code:/ {gsub("\r","",$2); print $2; exit}' "$tmp_headers")"
exit_code="${exit_code:-0}"

# Extract the audit-classification headers (case-insensitive; strip CR).
header_value() {
  awk -v h="$1" 'BEGIN{IGNORECASE=1} {
    if (tolower($0) ~ "^" tolower(h) ":") {
      sub(/^[^:]*:[ \t]*/, "", $0); gsub("\r", "", $0); print; exit
    }
  }' "$tmp_headers"
}

file_size_bytes() {
  NODE_NO_WARNINGS=1 node -e '
    const fs = require("fs");
    process.stdout.write(String(fs.statSync(process.argv[1]).size));
  ' "$1"
}

file_sha256() {
  NODE_NO_WARNINGS=1 node -e '
    const crypto = require("crypto");
    const fs = require("fs");
    const hash = crypto.createHash("sha256");
    const input = fs.createReadStream(process.argv[1]);
    input.on("data", (chunk) => hash.update(chunk));
    input.on("error", (err) => {
      process.stderr.write(String(err && err.message ? err.message : err));
      process.exit(1);
    });
    input.on("end", () => process.stdout.write(hash.digest("hex")));
  ' "$1"
}

revalidate_output_destination() {
  NODE_NO_WARNINGS=1 node -e '
    const fs = require("fs");
    const path = require("path");
    const plan = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    if (!plan.output) process.exit(0);

    function fail(message) {
      process.stderr.write(`Error: ${message}\n`);
      process.exit(2);
    }

    function insideRoot(candidate, root) {
      const rel = path.relative(root, candidate);
      return rel === "" || (!!rel && !rel.startsWith("..") && !path.isAbsolute(rel));
    }

    let parentReal;
    try {
      const stat = fs.statSync(plan.output.parent);
      parentReal = fs.realpathSync(plan.output.parent);
      if (!stat.isDirectory()) fail(`output parent path is not a directory: ${plan.output.parent}`);
    } catch {
      fail(`output parent directory does not exist: ${plan.output.parent}`);
    }
    if (parentReal !== plan.output.parent) {
      fail(`output parent directory changed before publish: ${plan.output.parent}`);
    }
    if (!plan.roots.some((root) => insideRoot(parentReal, root))) {
      fail(`output path ${plan.output.resolvedPath} is outside allowed output roots: ${plan.roots.join(":")}`);
    }
    const resolved = path.join(parentReal, plan.output.basename);
    if (resolved !== plan.output.resolvedPath) {
      fail("output destination changed before publish");
    }
    try {
      const targetStat = fs.lstatSync(resolved);
      if (targetStat.isSymbolicLink()) fail(`output target is a symlink: ${resolved}`);
      fail(`output target already exists: ${resolved}`);
    } catch (e) {
      if (e && e.code !== "ENOENT") throw e;
    }
  ' "$tmp_arg_plan"
}

print_output_success_json() {
  bytes="$(header_value 'X-GWS-Output-Bytes')"
  sha256="$(header_value 'X-GWS-Output-SHA256')"
  NODE_NO_WARNINGS=1 \
    GWS_OUTPUT_PATH="$output_resolved_path" \
    GWS_OUTPUT_BYTES="${bytes:-0}" \
    GWS_OUTPUT_SHA256="$sha256" \
    node -e '
      const savedFile = process.env.GWS_OUTPUT_PATH || "";
      const bytes = Number(process.env.GWS_OUTPUT_BYTES || "0");
      const sha256 = process.env.GWS_OUTPUT_SHA256 || "";
      process.stdout.write(JSON.stringify({ status: "success", saved_file: savedFile, bytes, sha256 }));
    '
}

body=""
if [ -z "$output_resolved_path" ] || [ "$http_code" != "200" ]; then
  body="$(cat "$curl_body_target" 2>/dev/null || true)"
fi

case "$http_code" in
  200)
    if [ -n "$output_resolved_path" ]; then
      proxy_output_kind="$(header_value 'X-GWS-Proxy-Output')"
      if [ "$exit_code" = "0" ] && [ "$proxy_output_kind" = "file" ]; then
        expected_bytes="$(header_value 'X-GWS-Output-Bytes')"
        expected_sha256="$(header_value 'X-GWS-Output-SHA256')"
        actual_bytes="$(file_size_bytes "$tmp_output_body")"
        actual_sha256="$(file_sha256 "$tmp_output_body")"
        if [ -z "$expected_bytes" ] || [ -z "$expected_sha256" ] || \
           [ "$actual_bytes" != "$expected_bytes" ] || [ "$actual_sha256" != "$expected_sha256" ]; then
          rm -f "$tmp_output_body"
          tmp_output_body=""
          printf 'Error: GWS proxy output integrity check failed.\n' >&2
          exit 1
        fi
        revalidate_output_destination
        if ! ln "$tmp_output_body" "$output_resolved_path" 2>/dev/null; then
          rm -f "$tmp_output_body"
          tmp_output_body=""
          printf 'Error: output target already exists or cannot be created: %s\n' "$output_resolved_path" >&2
          exit 1
        fi
        rm -f "$tmp_output_body"
        tmp_output_body=""
        print_output_success_json
        exit 0
      fi
      if [ "$exit_code" = "0" ]; then
        rm -f "$tmp_output_body"
        tmp_output_body=""
        printf 'Error: GWS proxy did not return output bytes for -o/--output request.\n' >&2
        exit 1
      fi
      body="$(cat "$tmp_output_body" 2>/dev/null || true)"
      rm -f "$tmp_output_body"
      tmp_output_body=""
    fi
    api_effect="$(header_value 'X-GWS-Api-Effect')"
    op_succeeded="$(header_value 'X-GWS-Operation-Succeeded')"
    # Stage a sanitized gmail_draft_created ledger record ONLY for a successful
    # API-effect mutation, AFTER the response and BEFORE printing success. The
    # shim does NOT verify the signature (it cannot in POSIX sh and staged JSONL
    # is untrusted anyway) — it forwards sig+payload verbatim for the importer.
    if [ "$api_effect" = "true" ] && [ "$op_succeeded" = "true" ]; then
      ledger_path="${NANOCLAW_SIDE_EFFECT_LEDGER:-/workspace/side-effects.jsonl}"
      audit_id="$(header_value 'X-GWS-Audit-Id')"
      request_class="$(header_value 'X-GWS-Request-Class')"
      sig="$(header_value 'X-GWS-Side-Effect-Signature')"
      payload="$(header_value 'X-GWS-Side-Effect-Payload')"
      if [ -n "${NANOCLAW_SIDE_EFFECT_LEDGER:-}" ] || [ -e "/workspace" ]; then
        # Build the sanitized JSONL record with node (robust escaping). Args are
        # sanitized (method/resource preserved, long body fields redacted); the
        # stdout is scanned for an optional draft id; NO raw auth header / NO full
        # email body. Print exactly one line to stdout for the atomic append.
        #
        # Capture node's exit status WITHOUT letting the command-substitution
        # abort the script under `set -e`: a record-build failure AFTER a
        # successful API mutation must route through the SAME exit-75
        # partial-success path as an append failure (audit id, no body), never a
        # bare generic failure that hides that the draft already exists.
        record_build_status=0
        record_line="$(
          NODE_NO_WARNINGS=1 \
          NC_AUDIT_ID="$audit_id" NC_REQUEST_CLASS="$request_class" \
          NC_SIG="$sig" NC_PAYLOAD="$payload" NC_BODY="$body" \
          NANOCLAW_ACTIVE_INPUT_FILE="$active_input_file" \
          NANOCLAW_ACTIVE_INPUT_MAX_AGE_MS="$active_input_max_age_ms" \
          node -e '
            const fs = require("fs");
            const args = process.argv.slice(1);
            const REDACT = /^(--?)(body|message|text|html|content|raw|attachment)$/i;
            const sanitized = [];
            for (let i = 0; i < args.length; i++) {
              const a = args[i];
              sanitized.push(a);
              // Redact the VALUE following a long-body flag (preserve the flag name).
              if (REDACT.test(a) && i + 1 < args.length && !args[i + 1].startsWith("-")) {
                sanitized.push("[redacted]");
                i++;
              }
            }
            let inputId = null, routeKey = null;
            try {
              const ai = JSON.parse(fs.readFileSync(process.env.NANOCLAW_ACTIVE_INPUT_FILE, "utf8"));
              // Stale-by-timestamp ⇒ uncorrelated (same policy as the request body).
              const maxAge = Number(process.env.NANOCLAW_ACTIVE_INPUT_MAX_AGE_MS);
              const updatedAt = ai && typeof ai.updatedAt === "string" ? Date.parse(ai.updatedAt) : NaN;
              const stale =
                !Number.isFinite(updatedAt) ||
                (Number.isFinite(maxAge) && maxAge > 0 && Date.now() - updatedAt > maxAge);
              if (ai && !stale) {
                if (typeof ai.inputId === "string") inputId = ai.inputId;
                if (typeof ai.routeKey === "string") routeKey = ai.routeKey;
              }
            } catch (e) { /* uncorrelated diagnostic */ }
            // Best-effort draft id from stdout (e.g. "Draft created: r-987654" or JSON id).
            let draftId = null;
            const body = process.env.NC_BODY || "";
            let m = body.match(/\br-[0-9a-zA-Z_-]{4,}\b/);
            if (!m) m = body.match(/"(?:id|draft_id|draftId)"\s*:\s*"([^"]+)"/);
            if (m) draftId = m[1] || m[0];
            const rec = {
              kind: "gmail_draft_created",
              audit_id: process.env.NC_AUDIT_ID || null,
              request_class: process.env.NC_REQUEST_CLASS || null,
              occurred_at: new Date().toISOString(),
              input_id: inputId,
              route_key: routeKey,
              args: sanitized,
              signature: process.env.NC_SIG || undefined,
              payload: process.env.NC_PAYLOAD || undefined,
              evidence: draftId ? { draft_id: draftId } : {},
            };
            process.stdout.write(JSON.stringify(rec));
          ' -- "$@"
        )" || record_build_status=$?
        # A record-build failure after API success is a recoverable partial
        # success, NOT a generic failure: the draft exists but we could not stage
        # its ledger line. Route through the exit-75 message (audit id, no body).
        if [ "$record_build_status" -ne 0 ] || [ -z "$record_line" ]; then
          printf 'Error: GWS draft was created (audit_id=%s) but the side-effect ledger record could not be built. The draft exists; do not recreate it.\n' "$audit_id" >&2
          exit 75
        fi
        # TRUE atomic append: a single >> write of the whole line. Never
        # temp+rename (which would clobber a concurrent appender). If the append
        # fails AFTER the API mutation already succeeded, emit a structured
        # partial-success error (audit id only, no raw body) instead of success.
        if ! printf '%s\n' "$record_line" >> "$ledger_path" 2>/dev/null; then
          printf 'Error: GWS draft was created (audit_id=%s) but the side-effect ledger append failed. The draft exists; do not recreate it.\n' "$audit_id" >&2
          exit 75
        fi
      fi
    fi
    printf '%s' "$body"
    exit "$exit_code"
    ;;
  401|403)
    if [ "$http_code" = "401" ]; then
      printf 'Error: GWS proxy authentication failed. Confirm OneCLI grants the "Yente GWS Proxy" secret to this NanoClaw agent and injects Authorization for the GWS proxy host.\n' >&2
    fi
    printf '%s\n' "$body" >&2
    exit 1
    ;;
  *)
    printf 'Error: GWS proxy returned HTTP %s\n%s\n' "$http_code" "$body" >&2
    exit 1
    ;;
esac
