#!/bin/sh
# gws - OneCLI-mediated thin client for the GWS Policy Proxy.
# Agent containers must not receive GWS_PROXY_KEY or Google OAuth files.
# OneCLI injects proxy authorization for requests to GWS_PROXY_URL.

set -eu

case "${1:-}" in
  --version)
    echo "gws-proxy-shim 3.0.0"
    exit 0
    ;;
  --help|-h)
    cat <<'HELP'
gws - Google Workspace CLI (proxied)

Usage:
  gws --account personal auth status
  gws --account glowforge auth status
  gws --account personal --confirmed calendar +insert [flags]
  gws --account glowforge --target-parent FOLDER docs documents create [flags]
  gws --account personal <service> <resource-or-shortcut> [method] [flags]
  gws --account glowforge <service> <resource-or-shortcut> [method] [flags]

All non-local commands are forwarded to GWS_PROXY_URL/exec. OneCLI injects
proxy authorization at the network gateway. Each request targets exactly one
account; use two explicit commands when a task needs both accounts.
HELP
    exit 0
    ;;
esac

if [ "${1:-}" != "--account" ]; then
  echo "Error: remote GWS commands require --account personal|glowforge as the first two arguments." >&2
  exit 2
fi

account="${2:-}"
case "$account" in
  personal|glowforge) ;;
  *)
    echo "Error: --account must be exactly personal or glowforge." >&2
    exit 2
    ;;
esac
shift 2

proxy_confirmed=false
proxy_target_parent=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --confirmed)
      if [ "$proxy_confirmed" = true ]; then
        echo "Error: --confirmed may be supplied only once, immediately after --account LABEL." >&2
        exit 2
      fi
      proxy_confirmed=true
      shift
      ;;
    --target-parent)
      if [ -n "$proxy_target_parent" ] || [ "$#" -lt 2 ] || [ -z "$2" ]; then
        echo "Error: --target-parent requires one nonempty value immediately after --account LABEL." >&2
        exit 2
      fi
      proxy_target_parent="$2"
      shift 2
      ;;
    *) break ;;
  esac
done

if [ "$#" -eq 0 ]; then
  echo "Error: a GWS command is required after --account $account." >&2
  exit 2
fi
for arg in "$@"; do
  case "$arg" in
    --account|--account=*)
      echo "Error: --account is accepted exactly once, as the first two arguments." >&2
      exit 2
      ;;
    --confirmed|--confirmed=*|--target-parent|--target-parent=*)
      echo "Error: proxy-only --confirmed/--target-parent flags must appear immediately after --account LABEL." >&2
      exit 2
      ;;
  esac
done

if [ "${1:-}" = "auth" ] && { [ "${2:-}" != "status" ] || [ "$#" -ne 2 ]; }; then
  echo "Error: the only supported auth operation is exactly 'auth status'." >&2
  exit 2
fi

if [ -z "${GWS_PROXY_URL:-}" ]; then
  echo "Error: GWS_PROXY_URL is not set; GWS access is unavailable without the mediated proxy." >&2
  exit 1
fi
GWS_PROXY_URL="${GWS_PROXY_URL%/}"

curl_with_configured_proxy() {
  proxy="${YENTE_ONECLI_GATEWAY_PROXY_URL:-${http_proxy:-${HTTP_PROXY:-${HTTPS_PROXY:-${https_proxy:-${ALL_PROXY:-${all_proxy:-}}}}}}}"
  if [ -n "$proxy" ]; then
    curl --noproxy "" --proxy "$proxy" "$@"
  else
    curl "$@"
  fi
}

tmp_headers="$(mktemp)"
tmp_body="$(mktemp)"
tmp_arg_plan="$(mktemp)"
tmp_input_dir="$(mktemp -d)"
tmp_output_body=""
cleanup() {
  rm -f "$tmp_headers" "$tmp_body" "$tmp_arg_plan"
  if [ -n "$tmp_input_dir" ]; then
    rm -rf "$tmp_input_dir"
  fi
  if [ -n "$tmp_output_body" ]; then
    rm -f "$tmp_output_body"
  fi
}
trap cleanup EXIT

# Extract a response header case-insensitively and strip CR.
header_value() {
  awk -v h="$1" 'BEGIN{IGNORECASE=1} {
    if (tolower($0) ~ "^" tolower(h) ":") {
      sub(/^[^:]*:[ \t]*/, "", $0); gsub("\r", "", $0); print; exit
    }
  }' "$tmp_headers"
}

print_onecli_auth_error() {
  printf 'Error: GWS proxy authentication failed. Confirm OneCLI grants the "Yente GWS Proxy" secret to this NanoClaw agent and injects Authorization for the GWS proxy host.\n' >&2
}

case "${1:-}" in
  auth)
    if [ "${2:-}" = "status" ] && [ "$#" -eq 2 ]; then
      whoami_status=0
      http_code="$(
        curl_with_configured_proxy -sS -o "$tmp_body" -D "$tmp_headers" -w "%{http_code}" \
          -X POST \
          -H "Content-Type: application/json" \
          -d "{\"account\":\"$account\"}" \
          "$GWS_PROXY_URL/whoami" 2>/dev/null
      )" || whoami_status=$?
      if [ "$whoami_status" -ne 0 ] || [ -z "$http_code" ] || [ "$http_code" = "000" ]; then
        echo "Error: unable to reach GWS proxy at $GWS_PROXY_URL" >&2
        exit 1
      fi
      response_account="$(header_value 'X-GWS-Account')"
      if [ "$http_code" = "401" ] && [ -z "$response_account" ]; then
        # The proxy authenticates before it resolves the requested account, so
        # an authentication failure has no authoritative account to echo.
        # Diagnose the credential path without trusting or inventing a label.
        print_onecli_auth_error
        exit 1
      fi
      if [ "$response_account" != "$account" ]; then
        printf 'Error: GWS proxy response account did not match requested account %s.\n' "$account" >&2
        exit 1
      fi
      if [ "$http_code" = "401" ]; then
        print_onecli_auth_error
        exit 1
      fi
      if [ "$http_code" != "200" ]; then
        printf 'Error: GWS proxy identity check returned HTTP %s\n' "$http_code" >&2
        cat "$tmp_body" >&2
        exit 1
      fi
      cat "$tmp_body"
      exit 0
    fi
    ;;
esac

# Correlation is host-authenticated and mounted read-only over the otherwise
# agent-writable workspace. Never fall back to .active-input.json: the agent can
# edit that file and must not be able to forge recovery scope.
host_correlation_file="${NANOCLAW_HOST_CORRELATION_FILE:-/workspace/.host-correlation/current.json}"
host_lease_file="${NANOCLAW_HOST_LEASE_FILE:-/workspace/.host-correlation/active-lease.json}"

parse_status=0
readonly_output_roots="/workspace/agent:/workspace/outbox"
readonly_input_roots="/workspace/agent:/workspace/outbox"
readonly_write_operations_file="/usr/local/share/nanoclaw/gws-v0.18.1-write-operations.json"
readonly_request_helper="/usr/local/lib/nanoclaw/gws-request.mjs"
NODE_NO_WARNINGS=1 \
  GWS_ACCOUNT="$account" GWS_PROXY_CONFIRMED="$proxy_confirmed" GWS_PROXY_TARGET_PARENT="$proxy_target_parent" \
  NANOCLAW_HOST_CORRELATION_FILE="$host_correlation_file" NANOCLAW_HOST_LEASE_FILE="$host_lease_file" \
  GWS_SHIM_READONLY_OUTPUT_ROOTS="$readonly_output_roots" GWS_SHIM_READONLY_INPUT_ROOTS="$readonly_input_roots" \
  GWS_SHIM_WRITE_OPERATIONS_FILE="$readonly_write_operations_file" \
  node "$readonly_request_helper" "$tmp_arg_plan" "$tmp_input_dir" "$@" || parse_status=$?
if [ "$parse_status" -ne 0 ]; then
  exit "$parse_status"
fi

# Build the request body, folding in inputId/routeKey from the host correlation file
# so the proxy's audit store is correlated for crash-window discovery even when a
# kill happens before the JSONL append. The shim NEVER adds an Authorization
# header (OneCLI injects it at the gateway).
request_body="$(
  NODE_NO_WARNINGS=1 GWS_ARG_PLAN_FILE="$tmp_arg_plan" node -e '
    const fs = require("fs");
    const plan = JSON.parse(fs.readFileSync(process.env.GWS_ARG_PLAN_FILE, "utf8"));
    process.stdout.write(JSON.stringify(plan.request));
  '
)"

multipart_body="$(NODE_NO_WARNINGS=1 node -e 'const p=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(p.multipartBody||"")' "$tmp_arg_plan")"
multipart_content_type="$(NODE_NO_WARNINGS=1 node -e 'const p=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(p.multipartContentType||"")' "$tmp_arg_plan")"
request_is_write="$(NODE_NO_WARNINGS=1 node -e 'const p=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));process.stdout.write(p.isWrite?"true":"false")' "$tmp_arg_plan")"

output_resolved_path="$(
  NODE_NO_WARNINGS=1 node -e '
    const fs = require("fs");
    const plan = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    process.stdout.write(plan.output ? plan.output.resolvedPath : "");
  ' "$tmp_arg_plan"
)"
output_parent="$(
  NODE_NO_WARNINGS=1 node -e '
    const fs = require("fs");
    const plan = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    process.stdout.write(plan.output ? plan.output.parent : "");
  ' "$tmp_arg_plan"
)"
curl_body_target="$tmp_body"
if [ -n "$output_resolved_path" ]; then
  tmp_output_body="$(mktemp "$output_parent/.gws-output.XXXXXX")"
  curl_body_target="$tmp_output_body"
fi

curl_status=0
if [ -n "$multipart_body" ]; then
  http_code="$(
    curl_with_configured_proxy -sS -o "$curl_body_target" -D "$tmp_headers" -w "%{http_code}" \
      -X POST -H "Content-Type: $multipart_content_type" --data-binary "@$multipart_body" \
      "$GWS_PROXY_URL/exec" 2>/dev/null
  )" || curl_status=$?
else
  http_code="$(
    curl_with_configured_proxy -sS -o "$curl_body_target" -D "$tmp_headers" -w "%{http_code}" \
      -X POST -H "Content-Type: application/json" -d "$request_body" \
      "$GWS_PROXY_URL/exec" 2>/dev/null
  )" || curl_status=$?
fi
if [ "$curl_status" -ne 0 ]; then
  rm -f "$tmp_output_body"
  tmp_output_body=""
  if [ "$request_is_write" = true ]; then
    printf 'Error: the authenticated GWS write request was sent but the proxy response was lost. Manual reconciliation is required. Do not retry automatically.\n' >&2
    exit 75
  fi
  printf 'Error: GWS proxy transfer failed while receiving output bytes.\n' >&2
  exit 1
fi

if [ -z "$http_code" ] || [ "$http_code" = "000" ]; then
  rm -f "$tmp_output_body"
  tmp_output_body=""
  echo "Error: unable to reach GWS proxy at $GWS_PROXY_URL" >&2
  exit 1
fi

response_account="$(header_value 'X-GWS-Account')"
account_matches=true
if [ "$response_account" != "$account" ]; then
  account_matches=false
fi

exit_code="$(awk 'BEGIN{IGNORECASE=1} /^X-Exit-Code:/ {gsub("\r","",$2); print $2; exit}' "$tmp_headers")"
exit_code="${exit_code:-0}"

file_size_bytes() {
  NODE_NO_WARNINGS=1 node -e '
    const fs = require("fs");
    process.stdout.write(String(fs.statSync(process.argv[1]).size));
  ' "$1"
}

file_sha256() {
  NODE_NO_WARNINGS=1 node -e '
    const crypto = require("crypto");
    const fs = require("fs");
    const hash = crypto.createHash("sha256");
    const input = fs.createReadStream(process.argv[1]);
    input.on("data", (chunk) => hash.update(chunk));
    input.on("error", (err) => {
      process.stderr.write(String(err && err.message ? err.message : err));
      process.exit(1);
    });
    input.on("end", () => process.stdout.write(hash.digest("hex")));
  ' "$1"
}

revalidate_output_destination() {
  NODE_NO_WARNINGS=1 node -e '
    const fs = require("fs");
    const path = require("path");
    const plan = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    if (!plan.output) process.exit(0);

    function fail(message) {
      process.stderr.write(`Error: ${message}\n`);
      process.exit(2);
    }

    function insideRoot(candidate, root) {
      const rel = path.relative(root, candidate);
      return rel === "" || (!!rel && !rel.startsWith("..") && !path.isAbsolute(rel));
    }

    let parentReal;
    try {
      const stat = fs.statSync(plan.output.parent);
      parentReal = fs.realpathSync(plan.output.parent);
      if (!stat.isDirectory()) fail(`output parent path is not a directory: ${plan.output.parent}`);
    } catch {
      fail(`output parent directory does not exist: ${plan.output.parent}`);
    }
    if (parentReal !== plan.output.parent) {
      fail(`output parent directory changed before publish: ${plan.output.parent}`);
    }
    if (!plan.roots.some((root) => insideRoot(parentReal, root))) {
      fail(`output path ${plan.output.resolvedPath} is outside allowed output roots: ${plan.roots.join(":")}`);
    }
    const resolved = path.join(parentReal, plan.output.basename);
    if (resolved !== plan.output.resolvedPath) {
      fail("output destination changed before publish");
    }
    try {
      const targetStat = fs.lstatSync(resolved);
      if (targetStat.isSymbolicLink()) fail(`output target is a symlink: ${resolved}`);
      fail(`output target already exists: ${resolved}`);
    } catch (e) {
      if (e && e.code !== "ENOENT") throw e;
    }
  ' "$tmp_arg_plan"
}

print_output_success_json() {
  bytes="$(header_value 'X-GWS-Proxy-Output-Bytes')"
  sha256="$(header_value 'X-GWS-Proxy-Output-SHA256')"
  NODE_NO_WARNINGS=1 \
    GWS_OUTPUT_PATH="$output_resolved_path" \
    GWS_OUTPUT_BYTES="${bytes:-0}" \
    GWS_OUTPUT_SHA256="$sha256" \
    node -e '
      const savedFile = process.env.GWS_OUTPUT_PATH || "";
      const bytes = Number(process.env.GWS_OUTPUT_BYTES || "0");
      const sha256 = process.env.GWS_OUTPUT_SHA256 || "";
      process.stdout.write(JSON.stringify({ status: "success", saved_file: savedFile, bytes, sha256 }));
    '
}

body=""
# A non-200 response cannot carry completed-write recovery under the proxy
# contract. Except for the pre-resolution authentication case below,
# authenticate its account label before reading or printing any body, including
# policy and generic upstream error payloads.
if [ "$http_code" = "401" ] && [ -z "$response_account" ]; then
  # Authentication precedes account resolution. A headerless 401 is therefore
  # an actionable OneCLI credential failure, not evidence of an account match
  # or mismatch. Never expose the unauthenticated response body.
  rm -f "$tmp_output_body"
  tmp_output_body=""
  print_onecli_auth_error
  exit 1
fi
if [ "$http_code" != "200" ] && [ "$account_matches" != "true" ]; then
  rm -f "$tmp_output_body"
  tmp_output_body=""
  printf 'Error: GWS proxy response account did not match requested account %s.\n' "$account" >&2
  exit 1
fi
if [ -z "$output_resolved_path" ] || [ "$http_code" != "200" ]; then
  body="$(cat "$curl_body_target" 2>/dev/null || true)"
fi

# A proxy-side ambiguous mutation is not an ordinary HTTP failure. Preserve
# the canonical 502 + exit-75 + manual_only receipt so the provider cannot
# mistake an unknown write outcome for a safe retry. Authenticate the complete
# structured sentinel against the exact host input/route request first; an
# isolated X-Exit-Code header is never enough to enter this path.
if [ "$http_code" = "502" ] && [ "$exit_code" = "75" ]; then
  sentinel_outcome="$(header_value 'X-GWS-Outcome')"
  sentinel_upstream_outcome="$(header_value 'X-GWS-Upstream-Outcome')"
  sentinel_recorded="$(header_value 'X-GWS-Reconciliation-Recorded')"
  sentinel_audit_id="$(header_value 'X-GWS-Audit-Id')"
  sentinel_input_id="$(header_value 'X-GWS-Input-Id')"
  sentinel_route_key="$(header_value 'X-GWS-Route-Key')"
  sentinel_service="$(header_value 'X-GWS-Service')"
  sentinel_method="$(header_value 'X-GWS-Method')"
  sentinel_status=0
  NODE_NO_WARNINGS=1 \
    NC_SENTINEL_BODY_FILE="$curl_body_target" NC_REQUEST_BODY="$request_body" \
    NC_SENTINEL_OUTCOME="$sentinel_outcome" NC_SENTINEL_UPSTREAM_OUTCOME="$sentinel_upstream_outcome" \
    NC_SENTINEL_RECORDED="$sentinel_recorded" NC_SENTINEL_AUDIT_ID="$sentinel_audit_id" \
    NC_SENTINEL_INPUT_ID="$sentinel_input_id" NC_SENTINEL_ROUTE_KEY="$sentinel_route_key" \
    NC_SENTINEL_SERVICE="$sentinel_service" NC_SENTINEL_METHOD="$sentinel_method" \
    node -e '
      const fs = require("fs");
      const fail = () => process.exit(1);
      try {
        const request = JSON.parse(process.env.NC_REQUEST_BODY || "");
        const response = JSON.parse(fs.readFileSync(process.env.NC_SENTINEL_BODY_FILE, "utf8"));
        const recorded = process.env.NC_SENTINEL_RECORDED;
        const auditId = process.env.NC_SENTINEL_AUDIT_ID || "";
        if (process.env.NC_SENTINEL_OUTCOME !== "outcome_unknown" ||
            process.env.NC_SENTINEL_UPSTREAM_OUTCOME !== "outcome_unknown" ||
            (recorded !== "true" && recorded !== "false") ||
            !/^[\x21-\x7e]{1,256}$/.test(auditId) ||
            process.env.NC_SENTINEL_INPUT_ID !== request.input_id ||
            process.env.NC_SENTINEL_ROUTE_KEY !== request.route_key ||
            !(process.env.NC_SENTINEL_SERVICE || "") ||
            !(process.env.NC_SENTINEL_METHOD || "") ||
            !response || response.outcome !== "outcome_unknown" ||
            response.audit_id !== auditId || response.operator_reconciliation !== true ||
            response.reconciliation_recorded !== (recorded === "true") ||
            response.retry !== "manual_only") fail();
      } catch (_) { fail(); }
    ' 2>/dev/null || sentinel_status=$?
  if [ "$sentinel_status" -eq 0 ]; then
    if [ "$sentinel_recorded" = "true" ]; then
      printf 'Error: GWS write outcome is unknown (audit_id=%s); durable manual reconciliation is required. Do not retry automatically.\n' "$sentinel_audit_id" >&2
    else
      printf 'Error: GWS write outcome is unknown (audit_id=%s), and its durable reconciliation record failed. Manual reconciliation is required. Do not retry automatically.\n' "$sentinel_audit_id" >&2
    fi
    exit 75
  fi
fi

case "$http_code" in
  200)
    if [ -n "$output_resolved_path" ]; then
      if [ "$account_matches" != "true" ]; then
        # Retain bytes only in memory long enough to extract bounded mutation
        # evidence below. Never publish a file under an untrusted account label.
        body="$(cat "$tmp_output_body" 2>/dev/null || true)"
        rm -f "$tmp_output_body"
        tmp_output_body=""
      else
        proxy_output_kind="$(header_value 'X-GWS-Proxy-Output')"
      fi
      if [ "$account_matches" = "true" ] && [ "$exit_code" = "0" ] && [ "$proxy_output_kind" = "file" ]; then
        expected_bytes="$(header_value 'X-GWS-Proxy-Output-Bytes')"
        expected_sha256="$(header_value 'X-GWS-Proxy-Output-SHA256')"
        actual_bytes="$(file_size_bytes "$tmp_output_body")"
        actual_sha256="$(file_sha256 "$tmp_output_body")"
        if [ -z "$expected_bytes" ] || [ -z "$expected_sha256" ] || \
           [ "$actual_bytes" != "$expected_bytes" ] || [ "$actual_sha256" != "$expected_sha256" ]; then
          rm -f "$tmp_output_body"
          tmp_output_body=""
          printf 'Error: GWS proxy output integrity check failed.\n' >&2
          exit 1
        fi
        revalidate_output_destination
        if ! ln "$tmp_output_body" "$output_resolved_path" 2>/dev/null; then
          rm -f "$tmp_output_body"
          tmp_output_body=""
          printf 'Error: output target already exists or cannot be created: %s\n' "$output_resolved_path" >&2
          exit 1
        fi
        rm -f "$tmp_output_body"
        tmp_output_body=""
        print_output_success_json
        exit 0
      fi
      if [ "$account_matches" = "true" ] && [ "$exit_code" = "0" ]; then
        rm -f "$tmp_output_body"
        tmp_output_body=""
        printf 'Error: GWS proxy did not return output bytes for -o/--output request.\n' >&2
        exit 1
      fi
      if [ -n "$tmp_output_body" ]; then
        body="$(cat "$tmp_output_body" 2>/dev/null || true)"
        rm -f "$tmp_output_body"
        tmp_output_body=""
      fi
    fi
    api_effect="$(header_value 'X-GWS-Api-Effect')"
    op_succeeded="$(header_value 'X-GWS-Operation-Succeeded')"
    signed_mutation_staged=false
    # Stage a sanitized GWS mutation ledger record ONLY for a successful
    # API-effect mutation, AFTER the response and BEFORE printing success. Only
    # the exact signed gmail/users.drafts.create operation is classified as a
    # draft; legacy or non-Gmail evidence remains a generic GWS diagnostic. The
    # shim does NOT verify the signature (it cannot in POSIX sh and staged JSONL
    # is untrusted anyway) — it forwards sig+payload verbatim for the importer.
    if [ "$api_effect" = "true" ] && [ "$op_succeeded" = "true" ]; then
      ledger_path="${NANOCLAW_SIDE_EFFECT_LEDGER:-/workspace/side-effects.jsonl}"
      audit_id="$(header_value 'X-GWS-Audit-Id')"
      request_class="$(header_value 'X-GWS-Request-Class')"
      sig="$(header_value 'X-GWS-Side-Effect-Signature')"
      payload="$(header_value 'X-GWS-Side-Effect-Payload')"
      response_schema="$(header_value 'X-GWS-Side-Effect-Schema')"
      response_profile="$(header_value 'X-GWS-Profile')"
      response_account_label="$(header_value 'X-GWS-Account')"
      response_account_email="$(header_value 'X-GWS-Account-Email')"
      response_input_id="$(header_value 'X-GWS-Input-Id')"
      response_route_key="$(header_value 'X-GWS-Route-Key')"
      response_service="$(header_value 'X-GWS-Service')"
      response_method="$(header_value 'X-GWS-Method')"
      response_occurred_at="$(header_value 'X-GWS-Occurred-At')"
      if [ -n "${NANOCLAW_SIDE_EFFECT_LEDGER:-}" ] || [ -e "/workspace" ]; then
        # Build the sanitized JSONL record with node (robust escaping). Args are
        # sanitized (method/resource preserved, long body fields redacted); the
        # stdout is scanned for an optional draft id; NO raw auth header / NO full
        # email body. Print exactly one line to stdout for the atomic append.
        #
        # Capture node's exit status WITHOUT letting the command-substitution
        # abort the script under `set -e`: a record-build failure AFTER a
        # successful API mutation must route through the SAME exit-75
        # partial-success path as an append failure (audit id, no body), never a
        # bare generic failure that hides that the draft already exists.
        record_build_status=0
        record_line="$(
          NODE_NO_WARNINGS=1 \
          NC_AUDIT_ID="$audit_id" NC_REQUEST_CLASS="$request_class" \
          NC_SIG="$sig" NC_PAYLOAD="$payload" NC_BODY="$body" \
          NC_RESPONSE_SCHEMA="$response_schema" NC_RESPONSE_PROFILE="$response_profile" \
          NC_RESPONSE_ACCOUNT_LABEL="$response_account_label" NC_RESPONSE_ACCOUNT_EMAIL="$response_account_email" \
          NC_RESPONSE_INPUT_ID="$response_input_id" NC_RESPONSE_ROUTE_KEY="$response_route_key" \
          NC_RESPONSE_SERVICE="$response_service" NC_RESPONSE_METHOD="$response_method" \
          NC_RESPONSE_OCCURRED_AT="$response_occurred_at" \
          NC_REQUEST_ACCOUNT="$account" \
          NANOCLAW_HOST_CORRELATION_FILE="$host_correlation_file" \
          node -e '
            const fs = require("fs");
            const args = process.argv.slice(1);
            const REDACT = /^(--?)(body|message|text|html|content|raw|attachment)$/i;
            const sanitized = [];
            for (let i = 0; i < args.length; i++) {
              const a = args[i];
              sanitized.push(a);
              // Redact the VALUE following a long-body flag (preserve the flag name).
              if (REDACT.test(a) && i + 1 < args.length && !args[i + 1].startsWith("-")) {
                sanitized.push("[redacted]");
                i++;
              }
            }
            let inputId = null, routeKey = null, acceptedAt = null;
            try {
              const ai = JSON.parse(fs.readFileSync(process.env.NANOCLAW_HOST_CORRELATION_FILE, "utf8"));
              const parsedAcceptedAt = ai && typeof ai.acceptedAt === "string" ? Date.parse(ai.acceptedAt) : NaN;
              const canonical = (value) => typeof value === "string" && /^[\x21-\x7e]{1,512}$/.test(value);
              if (ai && ai.schemaVersion === 1 && Number.isFinite(parsedAcceptedAt) && canonical(ai.inputId) && canonical(ai.routeKey)) {
                inputId = ai.inputId;
                routeKey = ai.routeKey;
                acceptedAt = ai.acceptedAt;
              }
            } catch (e) { /* uncorrelated diagnostic */ }
            // Best-effort draft id from stdout (e.g. "Draft created: r-987654" or JSON id).
            let draftId = null;
            const body = process.env.NC_BODY || "";
            let m = body.match(/\br-[0-9a-zA-Z_-]{4,}\b/);
            if (!m) m = body.match(/"(?:id|draft_id|draftId)"\s*:\s*"([^"]+)"/);
            if (m) draftId = m[1] || m[0];
            const positional = [];
            for (const arg of args) {
              if (arg === "--" || arg.startsWith("-")) break;
              positional.push(arg);
            }
            const invokedService = positional[0] || null;
            const invokedMethod = positional.length > 1 ? positional.slice(1).join(".") : null;
            const responseService = process.env.NC_RESPONSE_SERVICE || null;
            const responseMethod = process.env.NC_RESPONSE_METHOD || null;
            let signed = null, signedService = null, signedMethod = null;
            try {
              signed = JSON.parse(process.env.NC_PAYLOAD || "");
              if (signed && signed.schema_version === 2) {
                signedService = typeof signed.service === "string" ? signed.service : null;
                signedMethod = typeof signed.method === "string" ? signed.method : null;
              }
            } catch (e) { /* schema-v1 diagnostic */ }
            const exactDraft =
              invokedService === "gmail" &&
              invokedMethod === "users.drafts.create" &&
              responseService === invokedService &&
              responseMethod === invokedMethod &&
              signedService === invokedService &&
              signedMethod === invokedMethod;
            const requestAccount = process.env.NC_REQUEST_ACCOUNT || null;
            const expectedAccountEmail = requestAccount === "personal"
              ? "dan@danshapiro.com"
              : requestAccount === "glowforge"
                ? "dan@glowforge.com"
                : null;
            const rec = {
              kind: exactDraft ? "gmail_draft_created" : "gws_mutation_completed",
              payload_schema_version: Number(process.env.NC_RESPONSE_SCHEMA) === 2 ? 2 : 1,
              // Every duplicated binding remains independently known: request
              // account/operation, host correlation, and response headers. A
              // signed payload never gets to manufacture its own verifier
              // inputs, even when the transport account label is anomalous.
              audit_id: process.env.NC_AUDIT_ID || null,
              profile: process.env.NC_RESPONSE_PROFILE || null,
              account_label: requestAccount,
              response_account_label: process.env.NC_RESPONSE_ACCOUNT_LABEL || null,
              account_email: expectedAccountEmail,
              request_class: process.env.NC_REQUEST_CLASS || null,
              occurred_at: process.env.NC_RESPONSE_OCCURRED_AT || acceptedAt || null,
              input_id: inputId,
              route_key: routeKey,
              operation: invokedService && invokedMethod ? `${invokedService} ${invokedMethod}` : null,
              response_input_id: process.env.NC_RESPONSE_INPUT_ID || null,
              response_route_key: process.env.NC_RESPONSE_ROUTE_KEY || null,
              response_service: responseService,
              response_method: responseMethod,
              args: sanitized,
              signature: process.env.NC_SIG || undefined,
              payload: process.env.NC_PAYLOAD || undefined,
              evidence: exactDraft && draftId ? { draft_id: draftId } : {},
            };
            process.stdout.write(JSON.stringify(rec));
          ' -- "$@"
        )" || record_build_status=$?
        # A record-build failure after API success is a recoverable partial
        # success, NOT a generic failure: the draft exists but we could not stage
        # its ledger line. Route through the exit-75 message (audit id, no body).
        if [ "$record_build_status" -ne 0 ] || [ -z "$record_line" ]; then
          printf 'Error: GWS operation completed (audit_id=%s) but the side-effect ledger record could not be built. Do not recreate it automatically.\n' "$audit_id" >&2
          exit 75
        fi
        # TRUE atomic append: a single >> write of the whole line. Never
        # temp+rename (which would clobber a concurrent appender). If the append
        # fails AFTER the API mutation already succeeded, emit a structured
        # partial-success error (audit id only, no raw body) instead of success.
        append_status=0
        NC_LEDGER_PATH="$ledger_path" NC_RECORD_LINE="$record_line" NODE_NO_WARNINGS=1 node -e '
          const fs = require("fs");
          const path = require("path");
          let fd;
          let parentFd;
          try {
            fd = fs.openSync(
              process.env.NC_LEDGER_PATH,
              fs.constants.O_RDWR | fs.constants.O_CREAT | fs.constants.O_APPEND | fs.constants.O_NOFOLLOW,
              0o600,
            );
            const existing = fs.readFileSync(fd, "utf8");
            if (existing.length > 0 && !existing.endsWith("\n")) {
              throw new Error("incomplete side-effect ledger tail");
            }
            for (const prior of existing.split("\n")) {
              if (!prior) continue;
              JSON.parse(prior);
            }
            JSON.parse(process.env.NC_RECORD_LINE);
            const line = Buffer.from(`${process.env.NC_RECORD_LINE}\n`);
            if (fs.writeSync(fd, line) !== line.length) throw new Error("short side-effect ledger append");
            fs.fsyncSync(fd);
            parentFd = fs.openSync(path.dirname(process.env.NC_LEDGER_PATH), fs.constants.O_RDONLY);
            fs.fsyncSync(parentFd);
          } finally {
            if (parentFd !== undefined) fs.closeSync(parentFd);
            if (fd !== undefined) fs.closeSync(fd);
          }
        ' 2>/dev/null || append_status=$?
        if [ "$append_status" -ne 0 ]; then
          printf 'Error: GWS operation completed (audit_id=%s) but the durable side-effect ledger append failed. Do not recreate it automatically.\n' "$audit_id" >&2
          exit 75
        fi
        if [ "$response_schema" = "2" ] && [ -n "$sig" ] && [ -n "$payload" ]; then
          signed_mutation_staged=true
        fi
      fi
    fi
    outcome="$(header_value 'X-GWS-Outcome')"
    if [ "$account_matches" != "true" ]; then
      rm -f "$tmp_output_body"
      tmp_output_body=""
      if [ "$signed_mutation_staged" = "true" ]; then
        if [ "$outcome" = "completed_audit_failed" ]; then
          printf 'Error: GWS operation completed (audit_id=%s), but the response account did not match requested account %s and global audit failed. Reconcile the durable evidence; Do not retry automatically.\n' "$audit_id" "$account" >&2
        else
          printf 'Error: GWS operation completed (audit_id=%s), but the response account did not match requested account %s. Reconcile the durable evidence; Do not retry automatically.\n' "$audit_id" "$account" >&2
        fi
        exit 75
      fi
      printf 'Error: GWS proxy response account did not match requested account %s.\n' "$account" >&2
      exit 1
    fi
    if [ "$outcome" = "completed_audit_failed" ]; then
      printf 'Error: GWS operation completed (audit_id=%s) but global audit failed. Reconcile it; do not retry automatically.\n' "$(header_value 'X-GWS-Audit-Id')" >&2
      exit 75
    fi
    if [ -z "$output_resolved_path" ]; then
      cat "$curl_body_target"
    else
      # Output-mode CLI failures were moved out of the binary temp file above.
      printf '%s' "$body"
    fi
    exit "$exit_code"
    ;;
  401|403)
    if [ "$http_code" = "401" ]; then
      print_onecli_auth_error
    fi
    printf '%s\n' "$body" >&2
    exit 1
    ;;
  *)
    printf 'Error: GWS proxy returned HTTP %s\n%s\n' "$http_code" "$body" >&2
    exit 1
    ;;
esac
