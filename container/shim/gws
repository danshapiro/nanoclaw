#!/bin/sh
# gws — thin client shim for GWS Policy Proxy
# This script replaces the real gws binary in NanoClaw agent containers.
# It packages CLI arguments as JSON and POSTs to the proxy.
# The proxy returns plain text responses (not JSON).
#
# Environment:
#   GWS_PROXY_URL  — proxy base URL (e.g., http://host.docker.internal:8083)
#   GWS_PROXY_KEY  — bearer token for authentication

set -e

if [ -z "$GWS_PROXY_URL" ]; then
  echo "Error: GWS_PROXY_URL is not set" >&2
  exit 1
fi

if [ -z "$GWS_PROXY_KEY" ]; then
  echo "Error: GWS_PROXY_KEY is not set" >&2
  exit 1
fi

# Special cases handled locally by the shim
case "$1" in
  --version)
    echo "gws-proxy-shim 1.0.0 (proxy: $GWS_PROXY_URL)"
    exit 0
    ;;
  --help)
    echo "gws — Google Workspace CLI (proxied)"
    echo "All commands are forwarded to the GWS Policy Proxy."
    echo "Usage: gws <service> <resource> [sub-resource] <method> [flags]"
    exit 0
    ;;
  auth)
    if [ "$2" = "status" ]; then
      HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" \
        -H "Authorization: Bearer $GWS_PROXY_KEY" \
        "$GWS_PROXY_URL/health" 2>/dev/null) || HTTP_CODE=0
      if [ "$HTTP_CODE" = "200" ]; then
        echo '{"auth_method": "proxy", "proxy_url": "'"$GWS_PROXY_URL"'", "status": "connected"}'
        exit 0
      else
        echo '{"auth_method": "proxy", "proxy_url": "'"$GWS_PROXY_URL"'", "status": "unreachable"}'
        exit 1
      fi
    fi
    ;;
esac

ARGS_JSON=$(node -e "process.stdout.write(JSON.stringify(process.argv.slice(1)))" -- "$@")

TMPHEADERS=$(mktemp)
TMPBODY=$(mktemp)
HTTP_CODE=$(curl -s -o "$TMPBODY" -D "$TMPHEADERS" -w "%{http_code}" \
  -X POST \
  -H "Authorization: Bearer $GWS_PROXY_KEY" \
  -H "Content-Type: application/json" \
  -d "{\"args\": $ARGS_JSON}" \
  "$GWS_PROXY_URL/exec" 2>/dev/null) || {
    rm -f "$TMPBODY" "$TMPHEADERS"
    echo "Error: unable to reach GWS proxy at $GWS_PROXY_URL" >&2
    exit 1
  }

BODY=$(cat "$TMPBODY")
EXIT_CODE=$(grep -i '^X-Exit-Code:' "$TMPHEADERS" | tr -d '\r' | awk '{print $2}') || EXIT_CODE=0
EXIT_CODE=${EXIT_CODE:-0}
rm -f "$TMPBODY" "$TMPHEADERS"

case "$HTTP_CODE" in
  200) printf '%s' "$BODY"; exit "$EXIT_CODE" ;;
  *)   printf '%s\n' "$BODY" >&2; exit 1 ;;
esac
